# Copy to root-apps.yaml (see .gitignore) and apply once:
#   kubectl apply -f demo/apps/root-apps.yaml -n argocd
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: demo-apps-root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/saurabhrsahu/demo-projects.git
    targetRevision: HEAD
    path: demo/apps
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
